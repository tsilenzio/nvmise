# Differences between nvmise and official nvm that are there on purpose,
# because Node versions live in mise's folder and mise installs them.
# One rule per line: <case> <shell> <what differs>, or
# <case> <shell> <what differs> ~ <line>, which takes the lines that fit
# out of both sides and compares the rest. A `*` at the start or end of a
# name stands for anything there.

# Versions, aliases and downloads are not in the nvm folder.
* * fs:home/.nvm/versions*
* * fs:home/.nvm/alias*
* * fs:home/.nvm/.cache*
# What nvmise and mise are told through settings of their own.
* * var:NVMISE_*
* * var:MISE_*

# Installing. mise downloads, checks and unpacks a release, and prints its
# own lines while it does. Official nvm prints others for the same steps.
# Both kinds are taken out wherever they appear: in what a case prints and
# in files a case writes them to. Everything else in those places is still
# compared, `Downloading and installing node v...` included.
* * * ~ mise *
* * * ~   node@*
* * * ~ Downloading <mirror>/*
* * * ~ Computing checksum with *
* * * ~ Checksums matched!
* * * ~ *#####*
# mise's own `bin/npm` runs `mise reshim` by name after a global install.
# The harness's shells have no mise on PATH, and a person's would.
* * * ~ Reshimming mise *
* * * ~ *: mise: command not found

# Narrower rules for cases that differ in one named place only.
# nvmise doesn't offer io.js, so TAB doesn't suggest , and it turns
# `nvm cache` down, so TAB doesn't suggest `cache`.
HLP-07b * stdout ~ iojs
HLP-08 * stdout ~ iojs
HLP-08 * var:COMPREPLY
HLP-08b * stdout ~ iojs
HLP-08b * var:COMPREPLY
HLP-06a * stdout ~ cache
# A case that lists every variable sees nvmise's and mise's settings.
SHL-09c * fs:home/env-* ~ MISE_*
SHL-09c * fs:home/env-* ~ NVMISE_*
# nvm leaves the alias file's path in ALIAS, and nvmise's aliases are in
# a folder of their own.
UNI-07 * var:ALIAS

